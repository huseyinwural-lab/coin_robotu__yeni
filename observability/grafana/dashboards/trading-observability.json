{
  "id": null,
  "title": "Trading Observability Overview",
  "uid": "trading-observability-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP Request Rate",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki-main" },
      "targets": [
        {
          "expr": "sum by (method, status_code) (rate({job=\"backend-supervisor\", event_type=\"http_request\"}[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Validation Failures by Reason",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki-main" },
      "targets": [
        {
          "expr": "sum by (reason_code) (rate({job=\"backend-supervisor\", event_type=\"exchange_validation_failure\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Health Transition Flap Signal",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki-main" },
      "targets": [
        {
          "expr": "sum by (user_id) (count_over_time({job=\"backend-supervisor\", event_type=\"exchange_health_transition\"}[10m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Latest Critical Validation Logs",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki-main" },
      "targets": [
        {
          "expr": "{job=\"backend-supervisor\", event_type=\"exchange_validation_failure\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
